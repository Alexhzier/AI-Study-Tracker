# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App timezone (IANA). Used for "today", week/month boundaries and the calendar.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Manila

# --- AI Study Planner (server-side only: never prefix these with NEXT_PUBLIC_) ---
# Free option: Google Gemini (key from aistudio.google.com, no credit card needed)
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
# Copy a model ID that AI Studio marks as free (a Flash or Flash-Lite model works well)
AI_MODEL=
#
# Paid option: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-5.4-mini
#
# Cost and privacy controls (optional; defaults shown)
AI_DAILY_PLAN_LIMIT=5
AI_COOLDOWN_SECONDS=20
AI_MAX_OUTPUT_TOKENS=6000
AI_SHARE_NOTES=true

# --- Portfolio demo (optional; defaults shown) ---
# Plans each demo guest may generate per 24 hours, and the total across ALL guests.
AI_GUEST_PLAN_LIMIT=2
AI_GUEST_GLOBAL_DAILY_LIMIT=30
# If set, only Vercel Cron (which sends it automatically) may call /api/keepalive.
# CRON_SECRET=a-long-random-string

# NOTE: The Supabase service-role key is intentionally NOT used by this app.
