# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App timezone (IANA). Used for "today", week/month boundaries and the calendar.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Manila

# NOTE: The service-role key is intentionally NOT used by this app.
# All access goes through the anon key + the signed-in user's JWT, enforced by RLS.
